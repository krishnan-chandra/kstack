amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping<String, Step> {
    ["biome"] {
        glob = "*.ts"
        check = "npm exec -- biome check --no-errors-on-unmatched --diagnostic-level=error {{ files }}"
        fix = "npm exec -- biome check --no-errors-on-unmatched --write --unsafe {{ files }}"
    }
    ["anti-slop"] {
        glob = "*.{js,mjs,ts}"
        check = "npm run lint:slop -- {{ files }}"
    }
    ["typecheck"] { check = "npm run typecheck" }
    ["check-exports"] { check = "npm run check:exports" }
    ["check-imports"] { check = "npm run check:imports" }
}

hooks {
    ["pre-commit"] {
        fix = false
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
