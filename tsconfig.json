{
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": false,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"lib": ["es2023"],
		"types": ["node"]
	},
	"include": ["extensions/**/*.ts", "skills/**/*.ts"]
}
