{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"kstack.ts",
			"kstack.test.ts",
			"kstack.manifest.test.mjs",
			"extensions/**",
			"install.mjs",
			"install.test.mjs",
			"check-exports.mjs",
			"check-exports.test.mjs",
			"startup-benchmark.mjs",
			"startup-benchmark/**/*.mjs",
			"skills/**/*.mjs",
			"skills/**/*.ts",
			"!**/node_modules"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn",
				"noImplicitAnyLet": "warn",
				"noControlCharactersInRegex": "warn",
				"useIterableCallbackReturn": "warn",
				"noAssignInExpressions": "warn"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	}
}
