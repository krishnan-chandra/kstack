{
	"name": "kstack",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@earendil-works/pi-ai": "^0.84.2",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"@types/node": "^22",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"benchmark:startup": "node scripts/startup-benchmark/index.mjs",
		"check:exports": "node scripts/check-exports/index.mjs",
		"check:imports": "node scripts/check-imports/index.mjs",
		"format": "biome check --write .",
		"lint": "biome check .",
		"lint:ci": "biome ci .",
		"test": "node --test --test-reporter=dot \"kstack.manifest.test.mjs\" \"kstack.test.ts\" \"scripts/check-exports/index.test.mjs\" \"scripts/check-imports/index.test.mjs\" \"scripts/install/index.test.mjs\" \"extensions/**/*.test.ts\" \"shell/**/*.test.mjs\" \"skills/**/*.test.ts\" \"skills/**/*.test.mjs\"",
		"test:extensions": "node --test --test-reporter=dot \"extensions/**/*.test.ts\"",
		"test:handoff": "node --test --test-reporter=dot \"extensions/handoff/**/*.test.ts\"",
		"test:session-archive": "node --test --test-reporter=dot \"extensions/session-archive/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json"
	},
	"pi": {
		"extensions": [
			"./kstack.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
